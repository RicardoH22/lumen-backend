@token_tutor = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjIyIiwiY29ycmVvIjoic2FudGlhZ29fdHV0b3JAY29ycmVvLmNvbSIsInJvbCI6InR1dG9yIiwiaWF0IjoxNzk0ODYwNDA2LCJleHAiOjE3OTQ4ODkyMDZ9.L3Tusjhoa_jGkgqoNj5O-2PQ0L_HJbEJ-Z2U-nyBKHc


### CONSULTAR TUTORÍAS
GET http://localhost:3000/api/tutorias/mis-tutorias
Authorization: Bearer {{token_estudiante}}

### 1. LOGIN ESTUDIANTE
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "correo": "alberto_test@correo.com",
  "password": "12345678"
}
### 2. CREAR SOLICITUD DE TUTORÍA
POST http://localhost:3000/api/solicitudes
Authorization: Bearer {{token_estudiante}}
Content-Type: application/json

{
  "materia": "Redes de Computadores",
  "tema_especifico": "Subnetting VLSM",
  "modalidad": "virtual",
  "duracion_horas": 2
}

### 3. CREAR TUTORÍA CONFIRMADA
POST http://localhost:3000/api/tutorias
Authorization: Bearer {{token_estudiante}}
Content-Type: application/json

{
  "solicitud_id": 11,
  "oferta_id": 19,
  "tutor_id": 22
}

### 4. CONSULTAR MIS TUTORÍAS
GET http://localhost:3000/api/tutorias/mis-tutorias
Authorization: Bearer {{token_estudiante}}

### 5. ASIGNAR ENLACE DE SALA (TUTOR)
PATCH http://localhost:3000/api/tutorias/9/enlace
Authorization: Bearer {{token_tutor}}
Content-Type: application/json

{
  "enlace_sala": "https://meet.google.com/lumen-tutoria-9"
}

### 6. FINALIZAR TUTORÍA
PATCH http://localhost:3000/api/tutorias/9/estado
Authorization: Bearer {{token_estudiante}}
Content-Type: application/json

{
  "estado": "finalizada"
}